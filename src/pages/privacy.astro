---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
---

<Layout title="Privacy Policy">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Privacy Policy</Fragment>
      <Fragment slot="desc">Last Updated: January 25, 2026</Fragment>
    </Sectionhead>

    <div class="max-w-4xl mx-auto mt-16 space-y-8">
      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Introduction</h2>
        <p class="text-lg leading-relaxed text-slate-500">
          Sileninja ("we," "our," or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, and safeguard your information when you use our mobile application.
        </p>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Information We Collect</h2>
        
        <h3 class="font-semibold text-xl text-gray-700 mt-6 mb-3">Audio Data</h3>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>Sileninja accesses your device's microphone only to set up and check the protection on your device (for example, measuring how your speaker sounds)</li>
          <li><strong class="text-gray-700">We do NOT record, store, or transmit any audio data</strong></li>
          <li>All audio processing happens locally on your device</li>
        </ul>

        <h3 class="font-semibold text-xl text-gray-700 mt-6 mb-3">Subscription Information</h3>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>If you subscribe to Sileninja Premium, payment processing is handled entirely by Apple through the App Store</li>
          <li>We do not have access to your payment information</li>
          <li>We receive only confirmation of your subscription status</li>
        </ul>

        <h3 class="font-semibold text-xl text-gray-700 mt-6 mb-3">Device Information</h3>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>We may collect anonymous device information for app functionality (device model, iOS version)</li>
          <li>This information is used solely to tune the protection for your specific device</li>
        </ul>

        <h3 class="font-semibold text-xl text-gray-700 mt-6 mb-3">Analytics (Optional)</h3>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>We may collect anonymous usage analytics to improve the app</li>
          <li>This data cannot be used to identify you personally</li>
        </ul>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">How We Use Your Information</h2>
        <p class="text-lg leading-relaxed text-slate-500 mb-3">We use information solely to:</p>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>Provide privacy protection services</li>
          <li>Verify your subscription status</li>
          <li>Improve app performance and user experience</li>
        </ul>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Data Storage and Security</h2>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>All audio processing occurs locally on your device</li>
          <li>We do not store personal data on external servers</li>
          <li>Subscription verification is handled securely through Apple's infrastructure</li>
        </ul>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Third-Party Services</h2>
        
        <h3 class="font-semibold text-xl text-gray-700 mt-6 mb-3">Apple App Store</h3>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>Subscription management and payments are processed by Apple</li>
          <li>Apple's privacy policy applies to payment processing</li>
        </ul>

        <h3 class="font-semibold text-xl text-gray-700 mt-6 mb-3">RevenueCat</h3>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>We use RevenueCat for subscription management</li>
          <li>RevenueCat processes only subscription status data</li>
          <li>See RevenueCat's privacy policy: <a href="https://www.revenuecat.com/privacy" class="text-indigo-600 hover:underline" target="_blank" rel="noopener">https://www.revenuecat.com/privacy</a></li>
        </ul>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Children's Privacy</h2>
        <p class="text-lg leading-relaxed text-slate-500">
          Sileninja is not intended for children under 13. We do not knowingly collect information from children under 13.
        </p>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Your Rights</h2>
        <p class="text-lg leading-relaxed text-slate-500 mb-3">You have the right to:</p>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>Access information we hold about you</li>
          <li>Request deletion of your data</li>
          <li>Opt out of analytics collection</li>
        </ul>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Changes to This Policy</h2>
        <p class="text-lg leading-relaxed text-slate-500">
          We may update this Privacy Policy periodically. We will notify you of any changes by posting the new policy in the app.
        </p>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">Contact Us</h2>
        <p class="text-lg leading-relaxed text-slate-500 mb-3">If you have questions about this Privacy Policy, please contact us at:</p>
        <ul class="list-disc list-inside text-lg leading-relaxed text-slate-500 space-y-2">
          <li>Email: <a href="mailto:privacy@sileninja.com" class="text-indigo-600 hover:underline">privacy@sileninja.com</a></li>
          <li>Website: <a href="/contact" class="text-indigo-600 hover:underline">sileninja.com/contact</a></li>
        </ul>
      </section>

      <section>
        <h2 class="font-bold text-2xl text-gray-800 mb-4">California Privacy Rights</h2>
        <p class="text-lg leading-relaxed text-slate-500">
          California residents may have additional rights under the CCPA. Contact us for more information.
        </p>
      </section>
    </div>
  </Container>
</Layout>
